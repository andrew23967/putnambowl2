# Copy this file to .env and fill in values.
# .env is gitignored — never commit it.

# ── Local development (DEBUG=True, SQLite) ─────────────
SECRET_KEY=dev-only-insecure-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=*

# ── Production / Railway (uncomment and set these) ─────
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# SECRET_KEY=<generated key>
# DEBUG=False
# ALLOWED_HOSTS=your-app.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
#
# DATABASE_URL is set automatically by Railway when you add a PostgreSQL plugin.
# You do NOT need to set it manually.

# ── Outbound email (Resend) ─────────────────────────────────────────────────
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=commissioner@putnambowl.com
# SITE_URL=https://www.putnambowl.com

# ── Gemini (recaps + PutnamBot's picks) ─────────────────────────────────────
# Must be set on the WORKER service, not just web, or PutnamBot degrades to
# random picks silently.
# GEMINI_API_KEY=xxxxxxxx

# ── Inbound email — the Emails feed ─────────────────────────────────────────
# The worker polls this mailbox and publishes league-wide mail on the site.
# Leave IMAP_HOST unset to disable ingestion entirely (nothing errors).
# These belong on the WORKER service; the web service never polls.
#
# Verify a setup with:  python manage.py fetch_emails --check
#
# Gmail: turn on 2FA, then create an App Password (not your login password) at
# https://myaccount.google.com/apppasswords
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=putnambowl.league@gmail.com
# IMAP_PASSWORD=xxxx xxxx xxxx xxxx
# IMAP_FOLDER=INBOX
# IMAP_MARK_SEEN=true
#
# The +tag that marks a message as picks rather than an announcement. Gmail
# delivers user+picks@gmail.com to user@gmail.com, so one mailbox does both jobs
# and no mailing list is needed. Rarely worth changing.
# PICKS_ADDRESS_TAG=picks
#
# Leave this ON in production. With it off, a forged From header is enough to
# publish to the home page — only disable it against a local test mailbox.
# INBOUND_REQUIRE_AUTH=true

# ── Outbound via the league mailbox ─────────────────────────────────────────
# Preferred over Resend when set, and it needs no new credential: the same app
# password as IMAP works for SMTP. Resend's sandbox sender only delivers to the
# Resend account owner until a domain is verified, so it cannot reach the league;
# Gmail can. Defaults are smtp.gmail.com:587 with the IMAP user/password, so
# usually there is nothing to set here at all.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=            # defaults to IMAP_USER
# SMTP_PASSWORD=        # defaults to IMAP_PASSWORD
